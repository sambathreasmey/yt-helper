+import { getTelegramClient } from "@/services/telegram-client";
 
 type AppFeature = "youtube" | "gold";
 
+const LAST_FEATURE_KEY = "helper-last-feature";
+
+/** Page to open first: the one the user used last time (YouTube on the very first visit). */
+function readInitialFeature(): AppFeature {
+  if (typeof window === "undefined") return "youtube";
+  try {
+    // Opened from a shared video link: always start on YouTube.
+    if (getTelegramClient()?.initDataUnsafe?.start_param) return "youtube";
+    const saved = window.localStorage.getItem(LAST_FEATURE_KEY);
+    if (saved === "gold" || saved === "youtube") return saved;
+  } catch {
+    // Storage can be unavailable; fall back to the default.
+  }
+  return "youtube";
+}
+
+function rememberFeature(feature: AppFeature) {
+  try {
+    window.localStorage.setItem(LAST_FEATURE_KEY, feature);
+  } catch {
+    // Ignore storage errors: the choice just is not remembered.
+  }
+}
