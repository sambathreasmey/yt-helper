diff --git a/components/gold-summary-share-button.tsx b/components/gold-summary-share-button.tsx
new file mode 100644
index 0000000..6195cac
--- /dev/null
+++ b/components/gold-summary-share-button.tsx
@@ -0,0 +1,73 @@
+"use client";
+
+import { Share2 } from "lucide-react";
+import { useCallback, useState } from "react";
+import { ShareImageSheet, type ShareImageJob } from "@/components/share-image-sheet";
+import { formatProfit, formatQuantity, formatShortDate, formatUsd } from "@/features/gold-trading/gold-format";
+import { renderGoldSummaryCard, type GoldSummaryCardData, type Trend } from "@/lib/gold-summary-card";
+import { useLanguage } from "@/providers/language-provider";
+import type { GoldOverview } from "@/services/gold-trading-api";
+
+function trendOf(value: number | null): Trend {
+  if (value === null || Math.round(value * 100) === 0) return "flat";
+  return value > 0 ? "up" : "down";
+}
+
+/** Share button for the portfolio summary card: makes a designed image to share, copy or download. */
+export function GoldSummaryShareButton({ summary }: { summary: GoldOverview["summary"] }) {
+  const { t, locale } = useLanguage();
+  const [job, setJob] = useState<ShareImageJob | null>(null);
+
+  const open = useCallback(() => {
+    const total = summary.total_profit_loss === null ? null : Number(summary.total_profit_loss);
+    const unrealized = summary.unrealized_profit_loss === null ? null : Number(summary.unrealized_profit_loss);
+    const realized = Number(summary.realized_profit_loss);
+    const value = summary.market_value === null ? null : Number(summary.market_value);
+    const invested = Number(summary.total_purchase_cost);
+    const money = (amount: number | null) => (amount === null ? "\u2014" : formatUsd(String(amount), locale));
+    const profit = (amount: number | null) => (amount === null ? "\u2014" : formatProfit(String(amount), locale));
+
+    let heroPercent: string | null = null;
+    if (total !== null && Number.isFinite(invested) && invested > 0) {
+      const percent = (total / invested) * 100;
+      heroPercent = `${percent > 0 ? "+" : percent < 0 ? "\u2212" : ""}${Math.abs(percent).toFixed(2)}%`;
+    }
+
+    const data: GoldSummaryCardData = {
+      brand: "Helper",
+      subtitle: t("portfolio"),
+      date: formatShortDate(new Date().toISOString(), locale),
+      footer: window.location.host,
+      heroLabel: t("totalProfitLoss"),
+      heroValue: profit(total),
+      heroTrend: trendOf(total),
+      heroPercent,
+      tiles: [
+        { label: t("goldHeld"), value: `${formatQuantity(Number(summary.quantity_hun) / 100, locale)} ${t("damlungUnit")}` },
+        { label: t("costBasis"), value: money(Number(summary.cost_basis)) },
+        { label: t("currentValue"), value: money(value) },
+      ],
+      results: [
+        { label: t("realizedPL"), value: profit(realized), trend: trendOf(realized), icon: "realized" },
+        { label: t("unrealizedPL"), value: profit(unrealized), trend: trendOf(unrealized), icon: "unrealized" },
+      ],
+    };
+
+    setJob({
+      fileName: "helper-gold-portfolio.png",
+      shareTitle: data.brand,
+      shareText: `${data.heroLabel}: ${data.heroValue}`,
+      alt: data.heroLabel,
+      render: () => renderGoldSummaryCard(data),
+    });
+  }, [locale, summary, t]);
+
+  return (
+    <>
+      <button aria-label={t("shareSummaryTitle")} className="gold-share-button" onClick={open} type="button">
+        <Share2 aria-hidden="true" size={17} />
+      </button>
+      <ShareImageSheet job={job} onClose={() => setJob(null)} title={t("shareSummaryTitle")} />
+    </>
+  );
+}
diff --git a/components/share-image-sheet.tsx b/components/share-image-sheet.tsx
new file mode 100644
index 0000000..da075d9
--- /dev/null
+++ b/components/share-image-sheet.tsx
@@ -0,0 +1,117 @@
+"use client";
+
+import { Copy, Download, Share2 } from "lucide-react";
+import { useEffect, useState } from "react";
+import { BottomSheet } from "@/components/bottom-sheet";
+import { Button } from "@/components/ui/button";
+import { Skeleton } from "@/components/ui/skeleton";
+import { useLanguage } from "@/providers/language-provider";
+
+/** One image to preview and share. Create it when the user taps a share button; clear it to close the sheet. */
+export interface ShareImageJob {
+  fileName: string;
+  shareTitle: string;
+  shareText: string;
+  alt: string;
+  render: () => Promise<Blob>;
+}
+
+function ShareImagePanel({ job }: { job: ShareImageJob }) {
+  const { t } = useLanguage();
+  const [image, setImage] = useState<{ blob: Blob; url: string } | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [notice, setNotice] = useState<string | null>(null);
+
+  // Draw the card once when the sheet opens; free the image URL when it closes.
+  useEffect(() => {
+    let cancelled = false;
+    let objectUrl = "";
+    job
+      .render()
+      .then((blob) => {
+        if (cancelled) return;
+        objectUrl = URL.createObjectURL(blob);
+        setImage({ blob, url: objectUrl });
+      })
+      .catch(() => {
+        if (!cancelled) setFailed(true);
+      });
+    return () => {
+      cancelled = true;
+      if (objectUrl) URL.revokeObjectURL(objectUrl);
+    };
+  }, [job]);
+
+  const share = async () => {
+    if (!image) return;
+    const file = new File([image.blob], job.fileName, { type: "image/png" });
+    try {
+      if (typeof navigator.canShare !== "function" || !navigator.canShare({ files: [file] })) {
+        setNotice(t("shareFailed"));
+        return;
+      }
+      await navigator.share({ files: [file], title: job.shareTitle, text: job.shareText });
+      setNotice(null);
+    } catch (error) {
+      if ((error as Error)?.name !== "AbortError") setNotice(t("shareFailed"));
+    }
+  };
+
+  const copy = async () => {
+    if (!image) return;
+    try {
+      if (!navigator.clipboard?.write || typeof ClipboardItem === "undefined") throw new Error("unsupported");
+      await navigator.clipboard.write([new ClipboardItem({ "image/png": image.blob })]);
+      setNotice(t("shareCopied"));
+    } catch {
+      setNotice(t("shareFailed"));
+    }
+  };
+
+  const download = () => {
+    if (!image) return;
+    const link = document.createElement("a");
+    link.href = image.url;
+    link.download = job.fileName;
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+    setNotice(t("shareSaveHint"));
+  };
+
+  return (
+    <div className="gold-share-panel">
+      {failed ? (
+        <p className="gold-share-notice">{t("shareFailed")}</p>
+      ) : image ? (
+        // eslint-disable-next-line @next/next/no-img-element
+        <img alt={job.alt} className="gold-share-preview" src={image.url} />
+      ) : (
+        <Skeleton className="gold-share-preview" />
+      )}
+
+      <div className="gold-share-actions">
+        <Button disabled={!image} onClick={share} type="button" variant="primary">
+          <Share2 aria-hidden="true" size={17} /> {t("shareImage")}
+        </Button>
+        <Button disabled={!image} onClick={copy} type="button" variant="secondary">
+          <Copy aria-hidden="true" size={17} /> {t("copyImage")}
+        </Button>
+        <Button disabled={!image} onClick={download} type="button" variant="secondary">
+          <Download aria-hidden="true" size={17} /> {t("downloadImage")}
+        </Button>
+      </div>
+
+      {notice && <p className="gold-share-notice" role="status">{notice}</p>}
+    </div>
+  );
+}
+
+/** Bottom sheet with an image preview and Share / Copy image / Download actions. */
+export function ShareImageSheet({ job, title, onClose }: { job: ShareImageJob | null; title: string; onClose: () => void }) {
+  return (
+    <BottomSheet onClose={onClose} open={job !== null} title={title}>
+      {job && <ShareImagePanel job={job} />}
+    </BottomSheet>
+  );
+}
